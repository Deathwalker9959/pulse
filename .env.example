# ClickHouse
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DB=default

# Redis
REDIS_URL=redis://redis:6379/0

# USGS real-time GeoJSON feeds (updated every ~1–2 min by USGS)
# all_hour  → last 60 min, ~100 events  — primary real-time window
# all_day   → last 24 h,  ~1000 events — fills gaps if the poller missed a cycle
USGS_FEED_URL=https://earthquake.usgs.gov/earthquakes/feed/v1.0/summary/all_hour.geojson
USGS_SECONDARY_FEED_URL=https://earthquake.usgs.gov/earthquakes/feed/v1.0/summary/all_day.geojson
USGS_POLL_INTERVAL=60

# MinIO — S3-compatible storage used by ClickHouse cold tier
MINIO_ROOT_USER=pulse
MINIO_ROOT_PASSWORD=pulse_secret_dev
MINIO_BUCKET=pulse-archive

